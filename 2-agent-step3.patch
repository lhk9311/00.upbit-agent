+package com.lhk.upbitagent.store;
+
+import org.springframework.jdbc.core.namedparam.MapSqlParameterSource;
+import org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate;
+import org.springframework.stereotype.Repository;
+
+import java.util.List;
+
+import static com.lhk.upbitagent.store.StrategyRepository.nullableLong;
+
+@Repository
+public class AgentLogRepository {
+
+    public record AgentLog(long id, long createdAt, Long strategyId, String level, String message) {
+    }
+
+    private final NamedParameterJdbcTemplate jdbc;
+
+    public AgentLogRepository(NamedParameterJdbcTemplate jdbc) {
+        this.jdbc = jdbc;
+    }
+
+    public void add(Long strategyId, String level, String message) {
+        String msg = message.length() > 500 ? message.substring(0, 500) : message;
+        jdbc.update("""
+                INSERT INTO agent_log (created_at, strategy_id, level, message)
+                VALUES (:createdAt, :strategyId, :level, :message)
+                """, new MapSqlParameterSource()
+                .addValue("createdAt", System.currentTimeMillis())
+                .addValue("strategyId", strategyId)
+                .addValue("level", level)
+                .addValue("message", msg));
+    }
+
+    public List<AgentLog> recent(int limit) {
+        return jdbc.query("SELECT * FROM agent_log ORDER BY id DESC LIMIT " + Math.max(1, Math.min(limit, 500)),
+                (rs, i) -> new AgentLog(
+                        rs.getLong("id"),
+                        rs.getLong("created_at"),
+                        nullableLong(rs, "strategy_id"),
+                        rs.getString("level"),
+                        rs.getString("message")));
+    }
+}
diff --git a/backend/src/main/java/com/lhk/upbitagent/store/StrategyRepository.java b/backend/src/main/java/com/lhk/upbitagent/store/StrategyRepository.java
new file mode 100644
index 0000000..14b2d7e
--- /dev/null
+++ b/backend/src/main/java/com/lhk/upbitagent/store/StrategyRepository.java
@@ -0,0 +1,138 @@
+package com.lhk.upbitagent.store;
+
+import com.fasterxml.jackson.core.JsonProcessingException;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.lhk.upbitagent.agent.Strategy;
+import com.lhk.upbitagent.agent.TradeMode;
+import com.lhk.upbitagent.screener.ScreenerCondition;
+import org.springframework.jdbc.core.RowMapper;
+import org.springframework.jdbc.core.namedparam.MapSqlParameterSource;
+import org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate;
+import org.springframework.jdbc.support.GeneratedKeyHolder;
+import org.springframework.jdbc.support.KeyHolder;
+import org.springframework.stereotype.Repository;
+
+import java.sql.ResultSet;
+import java.sql.SQLException;
+import java.util.List;
+import java.util.Optional;
+
+@Repository
+public class StrategyRepository {
+
+    private final NamedParameterJdbcTemplate jdbc;
+    private final ObjectMapper objectMapper;
+
+    public StrategyRepository(NamedParameterJdbcTemplate jdbc, ObjectMapper objectMapper) {
+        this.jdbc = jdbc;
+        this.objectMapper = objectMapper;
+    }
+
+    public List<Strategy> findAll() {
+        return jdbc.query("SELECT * FROM strategy WHERE deleted = FALSE ORDER BY id DESC", mapper());
+    }
+
+    public Optional<Strategy> findById(long id) {
+        return jdbc.query("SELECT * FROM strategy WHERE id = :id AND deleted = FALSE",
+                new MapSqlParameterSource("id", id), mapper()).stream().findFirst();
+    }
+
+    public Strategy insert(Strategy s) {
+        KeyHolder key = new GeneratedKeyHolder();
+        jdbc.update("""
+                INSERT INTO strategy (name, condition_json, natural_text, order_krw, max_positions, take_profit_pct, stop_loss_pct,
+                                      trailing_stop_pct, max_hold_hours, daily_loss_limit_krw, mode, enabled, created_at)
+                VALUES (:name, :conditionJson, :naturalText, :orderKrw, :maxPositions, :takeProfitPct, :stopLossPct,
+                        :trailingStopPct, :maxHoldHours, :dailyLossLimitKrw, :mode, :enabled, :createdAt)
+                """, params(s), key, new String[]{"id"});
+        return findById(key.getKey().longValue()).orElseThrow();
+    }
+
+    public void update(Strategy s) {
+        jdbc.update("""
+                UPDATE strategy
+                   SET name = :name, condition_json = :conditionJson, natural_text = :naturalText, order_krw = :orderKrw,
+                       max_positions = :maxPositions, take_profit_pct = :takeProfitPct, stop_loss_pct = :stopLossPct,
+                       trailing_stop_pct = :trailingStopPct, max_hold_hours = :maxHoldHours,
+                       daily_loss_limit_krw = :dailyLossLimitKrw, mode = :mode, enabled = :enabled
+                 WHERE id = :id
+                """, params(s).addValue("id", s.id()));
+    }
+
+    public void setEnabled(long id, boolean enabled) {
+        jdbc.update("UPDATE strategy SET enabled = :enabled WHERE id = :id",
+                new MapSqlParameterSource("id", id).addValue("enabled", enabled));
+    }
+
+    /** 거래 기록이 전략을 참조하므로 실제로 지우지 않고 숨긴다 */
+    public void softDelete(long id) {
+        jdbc.update("UPDATE strategy SET deleted = TRUE, enabled = FALSE WHERE id = :id",
+                new MapSqlParameterSource("id", id));
+    }
+
+    private MapSqlParameterSource params(Strategy s) {
+        return new MapSqlParameterSource()
+                .addValue("name", s.name())
+                .addValue("conditionJson", toJson(s.condition()))
+                .addValue("naturalText", s.naturalText())
+                .addValue("orderKrw", s.orderKrw())
+                .addValue("maxPositions", s.maxPositions())
+                .addValue("takeProfitPct", s.takeProfitPct())
+                .addValue("stopLossPct", s.stopLossPct())
+                .addValue("trailingStopPct", s.trailingStopPct())
+                .addValue("maxHoldHours", s.maxHoldHours())
+                .addValue("dailyLossLimitKrw", s.dailyLossLimitKrw())
+                .addValue("mode", s.mode().name())
+                .addValue("enabled", s.enabled())
+                .addValue("createdAt", s.createdAt());
+    }
+
+    private RowMapper<Strategy> mapper() {
+        return (rs, i) -> new Strategy(
+                rs.getLong("id"),
+                rs.getString("name"),
+                fromJson(rs.getString("condition_json")),
+                rs.getString("natural_text"),
+                rs.getDouble("order_krw"),
+                rs.getInt("max_positions"),
+                nullableDouble(rs, "take_profit_pct"),
+                nullableDouble(rs, "stop_loss_pct"),
+                nullableDouble(rs, "trailing_stop_pct"),
+                nullableInt(rs, "max_hold_hours"),
+                nullableDouble(rs, "daily_loss_limit_krw"),
+                TradeMode.valueOf(rs.getString("mode")),
+                rs.getBoolean("enabled"),
+                rs.getLong("created_at"));
+    }
+
+    private String toJson(ScreenerCondition c) {
+        try {
+            return objectMapper.writeValueAsString(c);
+        } catch (JsonProcessingException e) {
+            throw new IllegalArgumentException("조건을 JSON 으로 바꾸지 못했어요", e);
+        }
+    }
+
+    private ScreenerCondition fromJson(String json) {
+        try {
+            return objectMapper.readValue(json, ScreenerCondition.class);
+        } catch (JsonProcessingException e) {
+            throw new IllegalStateException("저장된 조건 JSON 을 읽지 못했어요: " + json, e);
+        }
+    }
+
+    static Double nullableDouble(ResultSet rs, String col) throws SQLException {
+        double v = rs.getDouble(col);
+        return rs.wasNull() ? null : v;
+    }
+
+    static Integer nullableInt(ResultSet rs, String col) throws SQLException {
+        int v = rs.getInt(col);
+        return rs.wasNull() ? null : v;
+    }
+
+    static Long nullableLong(ResultSet rs, String col) throws SQLException {
+        long v = rs.getLong(col);
+        return rs.wasNull() ? null : v;
+    }
+}
diff --git a/backend/src/main/java/com/lhk/upbitagent/store/TradeRepository.java b/backend/src/main/java/com/lhk/upbitagent/store/TradeRepository.java
new file mode 100644
index 0000000..8f49593
--- /dev/null
+++ b/backend/src/main/java/com/lhk/upbitagent/store/TradeRepository.java
@@ -0,0 +1,194 @@
+package com.lhk.upbitagent.store;
+
+import com.lhk.upbitagent.agent.Trade;
+import com.lhk.upbitagent.agent.TradeMode;
+import com.lhk.upbitagent.agent.TradeStatus;
+import org.springframework.jdbc.core.RowMapper;
+import org.springframework.jdbc.core.namedparam.MapSqlParameterSource;
+import org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate;
+import org.springframework.jdbc.support.GeneratedKeyHolder;
+import org.springframework.jdbc.support.KeyHolder;
+import org.springframework.stereotype.Repository;
+
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.Set;
+
+import static com.lhk.upbitagent.store.StrategyRepository.nullableDouble;
+import static com.lhk.upbitagent.store.StrategyRepository.nullableLong;
+
+@Repository
+public class TradeRepository {
+
+    private static final String SELECT = """
+            SELECT t.*, s.name AS strategy_name
+              FROM trade t
+              LEFT JOIN strategy s ON s.id = t.strategy_id
+            """;
+
+    /** 화면 정렬 키 → 컬럼 (SQL 인젝션 방지용 화이트리스트) */
+    private static final Map<String, String> SORT_COLUMNS = Map.of(
+            "buyAt", "t.buy_at",
+            "sellAt", "t.sell_at",
+            "pnlRate", "t.pnl_rate",
+            "pnl", "t.pnl",
+            "market", "t.korean_name",
+            "buyPrice", "t.buy_price",
+            "sellPrice", "t.sell_price");
+
+    private final NamedParameterJdbcTemplate jdbc;
+
+    public TradeRepository(NamedParameterJdbcTemplate jdbc) {
+        this.jdbc = jdbc;
+    }
+
+    public long insert(Trade t) {
+        KeyHolder key = new GeneratedKeyHolder();
+        jdbc.update("""
+                INSERT INTO trade (strategy_id, market, korean_name, status, mode, buy_price, quantity,
+                                   buy_amount, buy_fee, buy_at, highest_price)
+                VALUES (:strategyId, :market, :koreanName, :status, :mode, :buyPrice, :quantity,
+                        :buyAmount, :buyFee, :buyAt, :highestPrice)
+                """, new MapSqlParameterSource()
+                .addValue("strategyId", t.strategyId())
+                .addValue("market", t.market())
+                .addValue("koreanName", t.koreanName())
+                .addValue("status", t.status().name())
+                .addValue("mode", t.mode().name())
+                .addValue("buyPrice", t.buyPrice())
+                .addValue("quantity", t.quantity())
+                .addValue("buyAmount", t.buyAmount())
+                .addValue("buyFee", t.buyFee())
+                .addValue("buyAt", t.buyAt())
+                .addValue("highestPrice", t.highestPrice()), key, new String[]{"id"});
+        return key.getKey().longValue();
+    }
+
+    /** 매도 체결 반영. 이미 닫힌 거래는 건드리지 않는다(중복 매도 방지) */
+    public boolean close(Trade t) {
+        int updated = jdbc.update("""
+                UPDATE trade
+                   SET status = 'CLOSED', sell_price = :sellPrice, sell_amount = :sellAmount, sell_fee = :sellFee,
+                       sell_at = :sellAt, sell_reason = :sellReason, pnl = :pnl, pnl_rate = :pnlRate
+                 WHERE id = :id AND status = 'OPEN'
+                """, new MapSqlParameterSource()
+                .addValue("id", t.id())
+                .addValue("sellPrice", t.sellPrice())
+                .addValue("sellAmount", t.sellAmount())
+                .addValue("sellFee", t.sellFee())
+                .addValue("sellAt", t.sellAt())
+                .addValue("sellReason", t.sellReason())
+                .addValue("pnl", t.pnl())
+                .addValue("pnlRate", t.pnlRate()));
+        return updated == 1;
+    }
+
+    public void updateHighest(long id, double highest) {
+        jdbc.update("UPDATE trade SET highest_price = :h WHERE id = :id AND status = 'OPEN'",
+                new MapSqlParameterSource("id", id).addValue("h", highest));
+    }
+
+    public Optional<Trade> findById(long id) {
+        return jdbc.query(SELECT + " WHERE t.id = :id", new MapSqlParameterSource("id", id), mapper())
+                .stream().findFirst();
+    }
+
+    public List<Trade> findOpen() {
+        return jdbc.query(SELECT + " WHERE t.status = 'OPEN' ORDER BY t.buy_at DESC", mapper());
+    }
+
+    public List<Trade> findOpenByStrategy(long strategyId) {
+        return jdbc.query(SELECT + " WHERE t.status = 'OPEN' AND t.strategy_id = :sid ORDER BY t.buy_at",
+                new MapSqlParameterSource("sid", strategyId), mapper());
+    }
+
+    /** 투자 히스토리 조회 */
+    public List<Trade> search(TradeSearch q) {
+        StringBuilder sql = new StringBuilder(SELECT).append(" WHERE 1 = 1");
+        MapSqlParameterSource p = new MapSqlParameterSource();
+
+        if (q.status() != null) {
+            sql.append(" AND t.status = :status");
+            p.addValue("status", q.status().name());
+        }
+        if (q.strategyId() != null) {
+            sql.append(" AND t.strategy_id = :sid");
+            p.addValue("sid", q.strategyId());
+        }
+        if (q.from() != null) {
+            sql.append(" AND t.buy_at >= :from");
+            p.addValue("from", q.from());
+        }
+        if (q.to() != null) {
+            sql.append(" AND t.buy_at < :to");
+            p.addValue("to", q.to());
+        }
+
+        String column = SORT_COLUMNS.getOrDefault(q.sort(), "t.buy_at");
+        String dir = "asc".equalsIgnoreCase(q.dir()) ? "ASC" : "DESC";
+        // 진행 중 거래는 매도 관련 값이 NULL 이라 정렬 시 항상 뒤로 보낸다
+        sql.append(" ORDER BY CASE WHEN ").append(column).append(" IS NULL THEN 1 ELSE 0 END, ")
+                .append(column).append(' ').append(dir).append(", t.id DESC");
+        sql.append(" LIMIT ").append(Math.max(1, Math.min(q.limit(), 1000)));
+
+        return jdbc.query(sql.toString(), p, mapper());
+    }
+
+    /** since 이후 매도된 거래의 실현손익 합계 */
+    public double realizedPnlSince(Long strategyId, long since) {
+        String sql = "SELECT COALESCE(SUM(pnl), 0) FROM trade WHERE status = 'CLOSED' AND sell_at >= :since"
+                + (strategyId == null ? "" : " AND strategy_id = :sid");
+        Double v = jdbc.queryForObject(sql,
+                new MapSqlParameterSource("since", since).addValue("sid", strategyId), Double.class);
+        return v == null ? 0 : v;
+    }
+
+    /** since 이후 매도한 종목 (재진입 대기용) */
+    public Set<String> soldMarketsSince(long strategyId, long since) {
+        return new HashSet<>(jdbc.queryForList(
+                "SELECT DISTINCT market FROM trade WHERE strategy_id = :sid AND status = 'CLOSED' AND sell_at >= :since",
+                new MapSqlParameterSource("sid", strategyId).addValue("since", since), String.class));
+    }
+
+    /** 완료 거래 통계: 건수, 이긴 건수, 실현손익 합계, 총 매수비용 */
+    public Map<String, Object> closedStats() {
+        return jdbc.queryForMap("""
+                SELECT COUNT(*)                                       AS closed_count,
+                       COALESCE(SUM(CASE WHEN pnl > 0 THEN 1 ELSE 0 END), 0) AS win_count,
+                       COALESCE(SUM(pnl), 0)                          AS realized_pnl,
+                       COALESCE(SUM(buy_amount + buy_fee), 0)         AS total_cost
+                  FROM trade
+                 WHERE status = 'CLOSED'
+                """, new MapSqlParameterSource());
+    }
+
+    public record TradeSearch(TradeStatus status, Long strategyId, Long from, Long to,
+                              String sort, String dir, int limit) {
+    }
+
+    private RowMapper<Trade> mapper() {
+        return (rs, i) -> new Trade(
+                rs.getLong("id"),
+                rs.getLong("strategy_id"),
+                rs.getString("strategy_name"),
+                rs.getString("market"),
+                rs.getString("korean_name"),
+                TradeStatus.valueOf(rs.getString("status")),
+                TradeMode.valueOf(rs.getString("mode")),
+                rs.getDouble("buy_price"),
+                rs.getDouble("quantity"),
+                rs.getDouble("buy_amount"),
+                rs.getDouble("buy_fee"),
+                rs.getLong("buy_at"),
+                rs.getDouble("highest_price"),
+                nullableDouble(rs, "sell_price"),
+                nullableDouble(rs, "sell_amount"),
+                nullableDouble(rs, "sell_fee"),
+                nullableLong(rs, "sell_at"),
+                rs.getString("sell_reason"),
+                nullableDouble(rs, "pnl"),
+                nullableDouble(rs, "pnl_rate"));
+    }
+}
diff --git a/backend/src/main/java/com/lhk/upbitagent/web/AgentController.java b/backend/src/main/java/com/lhk/upbitagent/web/AgentController.java
new file mode 100644
index 0000000..8885593
--- /dev/null
+++ b/backend/src/main/java/com/lhk/upbitagent/web/AgentController.java
@@ -0,0 +1,164 @@
+package com.lhk.upbitagent.web;
+
+import com.lhk.upbitagent.agent.AgentService;
+import com.lhk.upbitagent.agent.Strategy;
+import com.lhk.upbitagent.agent.StrategyRequest;
+import com.lhk.upbitagent.agent.Trade;
+import com.lhk.upbitagent.agent.TradeStatus;
+import com.lhk.upbitagent.store.AgentLogRepository;
+import com.lhk.upbitagent.store.StrategyRepository;
+import com.lhk.upbitagent.store.TradeRepository;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import java.util.List;
+import java.util.Map;
+
+@RestController
+@RequestMapping("/api")
+public class AgentController {
+
+    private final StrategyRepository strategies;
+    private final TradeRepository trades;
+    private final AgentLogRepository logs;
+    private final AgentService agent;
+
+    public AgentController(StrategyRepository strategies, TradeRepository trades,
+                           AgentLogRepository logs, AgentService agent) {
+        this.strategies = strategies;
+        this.trades = trades;
+        this.logs = logs;
+        this.agent = agent;
+    }
+
+    // ---------- 전략 ----------
+
+    @GetMapping("/strategies")
+    public List<Strategy> listStrategies() {
+        return strategies.findAll();
+    }
+
+    /** 전략 저장 (기본: 바로 시작). 저장 직후 한 주기를 돌려 첫 매수를 바로 확인할 수 있게 한다 */
+    @PostMapping("/strategies")
+    public Strategy createStrategy(@RequestBody StrategyRequest req) {
+        Strategy saved = strategies.insert(req.toStrategy(null, System.currentTimeMillis()));
+        logs.add(saved.id(), "INFO", "[" + saved.name() + "] 전략 저장" + (saved.enabled() ? " · 시작" : ""));
+        if (saved.enabled()) {
+            agent.runCycle();
+        }
+        return saved;
+    }
+
+    @PutMapping("/strategies/{id}")
+    public Strategy updateStrategy(@PathVariable long id, @RequestBody StrategyRequest req) {
+        Strategy old = findStrategy(id);
+        strategies.update(req.toStrategy(id, old.createdAt()));
+        logs.add(id, "INFO", "[" + req.name() + "] 전략 수정");
+        return findStrategy(id);
+    }
+
+    @PostMapping("/strategies/{id}/start")
+    public Strategy start(@PathVariable long id) {
+        Strategy s = findStrategy(id);
+        strategies.setEnabled(id, true);
+        logs.add(id, "INFO", "[" + s.name() + "] 시작");
+        agent.runCycle();
+        return findStrategy(id);
+    }
+
+    /** 정지: 신규 매수만 멈추고, 보유 중인 종목은 매도 규칙대로 계속 관리 */
+    @PostMapping("/strategies/{id}/stop")
+    public Strategy stop(@PathVariable long id) {
+        Strategy s = findStrategy(id);
+        strategies.setEnabled(id, false);
+        logs.add(id, "INFO", "[" + s.name() + "] 정지 (보유 종목은 매도 규칙대로 계속 관리)");
+        return findStrategy(id);
+    }
+
+    @DeleteMapping("/strategies/{id}")
+    public ResponseEntity<Void> delete(@PathVariable long id) {
+        Strategy s = findStrategy(id);
+        if (!trades.findOpenByStrategy(id).isEmpty()) {
+            throw new IllegalArgumentException("보유 중인 종목이 있어 삭제할 수 없어요. 먼저 매도하거나 정지 후 정리해주세요.");
+        }
+        strategies.softDelete(id);
+        logs.add(id, "INFO", "[" + s.name() + "] 삭제");
+        return ResponseEntity.noContent().build();
+    }
+
+    // ---------- 포지션·거래 ----------
+
+    /** 진행 중 거래 + 현재가 기준 평가손익 */
+    @GetMapping("/positions")
+    public List<AgentService.Position> positions() {
+        return agent.positions();
+    }
+
+    /** 수동 매도 */
+    @PostMapping("/trades/{id}/close")
+    public Trade close(@PathVariable long id) {
+        return agent.closeManually(id);
+    }
+
+    /**
+     * 투자 히스토리.
+     * status: OPEN | CLOSED | (생략=전체), sort: buyAt | sellAt | pnlRate | pnl | market | buyPrice | sellPrice
+     * from/to: 매수 시각 범위(epoch ms)
+     */
+    @GetMapping("/trades")
+    public List<Trade> trades(@RequestParam(required = false) TradeStatus status,
+                              @RequestParam(required = false) Long strategyId,
+                              @RequestParam(required = false) Long from,
+                              @RequestParam(required = false) Long to,
+                              @RequestParam(defaultValue = "buyAt") String sort,
+                              @RequestParam(defaultValue = "desc") String dir,
+                              @RequestParam(defaultValue = "300") int limit) {
+        return trades.search(new TradeRepository.TradeSearch(status, strategyId, from, to, sort, dir, limit));
+    }
+
+    // ---------- 에이전트 ----------
+
+    @GetMapping("/agent/summary")
+    public AgentService.Summary summary() {
+        return agent.summary();
+    }
+
+    @GetMapping("/agent/logs")
+    public List<AgentLogRepository.AgentLog> agentLogs(@RequestParam(defaultValue = "50") int limit) {
+        return logs.recent(limit);
+    }
+
+    /** 다음 주기를 기다리지 않고 바로 한 번 실행 (테스트용) */
+    @PostMapping("/agent/run")
+    public Map<String, String> runNow() {
+        agent.runCycle();
+        return Map.of("message", "한 주기를 실행했어요");
+    }
+
+    // ---------- 에러 ----------
+
+    private Strategy findStrategy(long id) {
+        return strategies.findById(id)
+                .orElseThrow(() -> new IllegalArgumentException("전략을 찾을 수 없어요: " + id));
+    }
+
+    @ExceptionHandler(IllegalArgumentException.class)
+    public ResponseEntity<Map<String, String>> badRequest(IllegalArgumentException e) {
+        return ResponseEntity.badRequest().body(Map.of("message", e.getMessage()));
+    }
+
+    @ExceptionHandler(IllegalStateException.class)
+    public ResponseEntity<Map<String, String>> conflict(IllegalStateException e) {
+        return ResponseEntity.status(HttpStatus.CONFLICT).body(Map.of("message", e.getMessage()));
+    }
+}
diff --git a/backend/src/main/resources/application.yml b/backend/src/main/resources/application.yml
index 9d57579..04b910d 100644
--- a/backend/src/main/resources/application.yml
+++ b/backend/src/main/resources/application.yml
@@ -7,8 +7,20 @@ spring:
   task:
     scheduling:
       pool:
