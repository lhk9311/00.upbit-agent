+    // static final : 클래스당 하나만 있으면 되고(static), 바뀔 일이 없다(final).
     private static final Logger log = LoggerFactory.getLogger(MarketCollector.class);
 
-    /** 수집 순서. 화면 기본값인 1시간봉을 가장 먼저 */
+    // ---------------------------------------------------------------
+    // 상수
