+++ b/backend/src/main/java/com/lhk/upbitagent/auth/JwtAuthFilter.java
@@ -0,0 +1,57 @@
+package com.lhk.upbitagent.auth;
+
+import jakarta.servlet.FilterChain;
+import jakarta.servlet.ServletException;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletResponse;
+import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
+import org.springframework.security.core.authority.SimpleGrantedAuthority;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.web.filter.OncePerRequestFilter;
+
+import java.io.IOException;
+import java.util.List;
+
+/**
+ * 모든 요청마다 한 번 실행되는 필터.
+ * "Authorization: Bearer 토큰" 헤더가 있고 토큰이 유효하면 "로그인한 사용자" 로 표시한다.
+ *
+ * 여기서 요청을 막지는 않는다. 표시만 하고 다음으로 넘긴다.
+ * 실제로 막는 건 SecurityConfig 의 규칙(authenticated())이다 → 표시가 없으면 401.
+ *
+ * @Component 를 붙이지 않은 이유: 붙이면 스프링이 일반 서블릿 필터로도 한 번 더 등록해서
+ * 같은 요청에 두 번 끼어들 수 있다. SecurityConfig 에서 직접 만들어 보안 필터 체인에만 넣는다.
+ */
+public class JwtAuthFilter extends OncePerRequestFilter {
+
+    private static final String PREFIX = "Bearer ";
+
+    private final JwtProvider jwt;
+    private final AppUserRepository users;
+
+    public JwtAuthFilter(JwtProvider jwt, AppUserRepository users) {
+        this.jwt = jwt;
+        this.users = users;
+    }
+
+    @Override
+    protected void doFilterInternal(HttpServletRequest request, HttpServletResponse response, FilterChain chain)
+            throws ServletException, IOException {
+
+        String header = request.getHeader("Authorization");
+
+        if (header != null && header.startsWith(PREFIX)) {
+            jwt.parse(header.substring(PREFIX.length()))
+                    // 토큰은 맞아도 계정이 지워졌거나 비밀번호를 바꾼 뒤라면 거부
+                    .flatMap(p -> users.findByUsername(p.username())
+                            .filter(u -> u.acceptsTokenIssuedAt(p.issuedAt())))
+                    .ifPresent(u -> {
+                        var auth = new UsernamePasswordAuthenticationToken(
+                                u.username(), null, List.of(new SimpleGrantedAuthority("ROLE_ADMIN")));
+                        SecurityContextHolder.getContext().setAuthentication(auth);
+                    });
+        }
+
+        chain.doFilter(request, response);
+    }
+}
diff --git a/backend/src/main/java/com/lhk/upbitagent/auth/JwtProvider.java b/backend/src/main/java/com/lhk/upbitagent/auth/JwtProvider.java
new file mode 100644
index 0000000..834e684
--- /dev/null
+++ b/backend/src/main/java/com/lhk/upbitagent/auth/JwtProvider.java
@@ -0,0 +1,87 @@
+package com.lhk.upbitagent.auth;
+
+import io.jsonwebtoken.Claims;
+import io.jsonwebtoken.JwtException;
+import io.jsonwebtoken.Jwts;
+import io.jsonwebtoken.security.Keys;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.stereotype.Component;
+
+import javax.crypto.SecretKey;
+import java.nio.charset.StandardCharsets;
+import java.security.SecureRandom;
+import java.util.Date;
+import java.util.Optional;
+
+/**
+ * JWT 발급·검증.
+ *
+ * JWT = "헤더.내용.서명" 세 덩어리를 점(.)으로 이은 문자열.
+ *  - 내용(payload): 누구인지(sub), 언제 발급(iat), 언제 만료(exp)
+ *  - 서명: 서버만 아는 비밀 키로 만든 값. 내용을 한 글자라도 바꾸면 서명이 안 맞아서 거부된다.
+ * 내용은 암호화가 아니라 Base64 인코딩이라 누구나 읽을 수 있다 → 비밀번호 같은 건 넣지 않는다.
+ *
+ * 세션 방식과의 차이:
+ *  - 세션: 서버가 "누가 로그인했는지" 를 메모리에 기억하고, 브라우저는 세션 ID 쿠키만 들고 다닌다.
+ *  - JWT : 서버는 아무것도 기억하지 않는다. 매 요청마다 토큰의 서명만 확인하면 누군지 안다.
+ */
+@Component
+public class JwtProvider {
+
+    private static final Logger log = LoggerFactory.getLogger(JwtProvider.class);
+
+    public record Issued(String token, long expiresAt) {
+    }
+
+    public record Parsed(String username, long issuedAt) {
+    }
+
+    private final SecretKey key;
+    private final long expiryMs;
+
+    public JwtProvider(@Value("${app.jwt.secret:}") String secret,
+                       @Value("${app.jwt.expiry-hours:12}") long expiryHours) {
+        byte[] bytes;
+        if (secret == null || secret.isBlank()) {
+            bytes = new byte[32];
+            new SecureRandom().nextBytes(bytes);
+            log.info("JWT_SECRET 이 설정되지 않아 임시 키를 만들었어요. 서버를 재시작하면 다시 로그인해야 해요.");
+        } else {
+            bytes = secret.getBytes(StandardCharsets.UTF_8);
+            if (bytes.length < 32) {
+                // HS256 은 최소 256비트(32바이트) 키가 필요하다
+                throw new IllegalStateException("JWT_SECRET 은 32자 이상이어야 해요 (지금 " + bytes.length + "자)");
+            }
+        }
+        this.key = Keys.hmacShaKeyFor(bytes);
+        this.expiryMs = expiryHours * 3_600_000L;
+    }
+
+    public Issued issue(String username) {
+        long now = System.currentTimeMillis();
+        Date expiresAt = new Date(now + expiryMs);
+        String token = Jwts.builder()
+                .subject(username)
+                .issuedAt(new Date(now))
+                .expiration(expiresAt)
+                .signWith(key)            // HS256 서명
+                .compact();
+        return new Issued(token, expiresAt.getTime());
+    }
+
+    /** 서명이 맞고 만료되지 않았으면 내용, 아니면 empty */
+    public Optional<Parsed> parse(String token) {
+        try {
+            Claims claims = Jwts.parser()
+                    .verifyWith(key)       // 서명 확인 + 만료 확인
+                    .build()
+                    .parseSignedClaims(token)
+                    .getPayload();
+            return Optional.of(new Parsed(claims.getSubject(), claims.getIssuedAt().getTime()));
+        } catch (JwtException | IllegalArgumentException e) {
+            return Optional.empty();       // 위조·만료·형식 오류
+        }
+    }
+}
diff --git a/backend/src/main/java/com/lhk/upbitagent/auth/LoginAttemptLimiter.java b/backend/src/main/java/com/lhk/upbitagent/auth/LoginAttemptLimiter.java
new file mode 100644
index 0000000..a478819
--- /dev/null
+++ b/backend/src/main/java/com/lhk/upbitagent/auth/LoginAttemptLimiter.java
@@ -0,0 +1,92 @@
+package com.lhk.upbitagent.auth;
+
+import java.util.ArrayDeque;
+import java.util.Deque;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * 로그인 시도 제한 (비밀번호 무차별 대입 방지).
+ *
+ * 규칙: 같은 아이디로 window 시간 안에 maxFailures 번 틀리면 lockMs 동안 잠근다.
+ * 로그인에 성공하면 그 아이디의 실패 기록은 지운다.
+ *
+ * 서버 메모리에만 저장하므로 서버를 재시작하면 초기화된다 (혼자 쓰는 서비스라 충분).
+ * Spring 에 의존하지 않는 순수 Java (시각을 파라미터로 받아서 테스트하기 쉽다).
+ */
+public class LoginAttemptLimiter {
+
+    private final int maxFailures;
+    private final long windowMs;
+    private final long lockMs;
+
+    /** 아이디 → 최근 실패 시각들 */
+    private final Map<String, Deque<Long>> failures = new HashMap<>();
+    /** 아이디 → 잠금이 풀리는 시각 */
+    private final Map<String, Long> lockedUntil = new HashMap<>();
+
+    public LoginAttemptLimiter(int maxFailures, long windowMs, long lockMs) {
+        this.maxFailures = maxFailures;
+        this.windowMs = windowMs;
+        this.lockMs = lockMs;
+    }
+
+    /** 기본값: 10분 안에 5번 틀리면 10분 잠금 */
+    public static LoginAttemptLimiter defaults() {
+        return new LoginAttemptLimiter(5, 10 * 60_000L, 10 * 60_000L);
+    }
+
+    /** 잠겨 있으면 풀리는 시각, 아니면 null */
+    public synchronized Long lockedUntil(String username, long now) {
+        String key = key(username);
+        Long until = lockedUntil.get(key);
+        if (until == null) {
+            return null;
+        }
+        if (now >= until) {
+            lockedUntil.remove(key);
+            failures.remove(key);
+            return null;
+        }
+        return until;
+    }
+
+    /**
+     * 실패 기록. 이번 실패로 잠기면 true.
+     */
+    public synchronized boolean recordFailure(String username, long now) {
+        String key = key(username);
+        Deque<Long> q = failures.computeIfAbsent(key, k -> new ArrayDeque<>());
+        q.addLast(now);
+        while (!q.isEmpty() && now - q.peekFirst() > windowMs) {
+            q.removeFirst(); // window 밖의 오래된 실패는 버림
+        }
+        if (q.size() >= maxFailures) {
+            lockedUntil.put(key, now + lockMs);
+            q.clear();
+            return true;
+        }
+        return false;
+    }
+
+    /** 잠기기 전까지 남은 시도 횟수 */
+    public synchronized int remainingAttempts(String username, long now) {
+        Deque<Long> q = failures.get(key(username));
+        if (q == null) {
+            return maxFailures;
+        }
+        long recent = q.stream().filter(t -> now - t <= windowMs).count();
+        return (int) Math.max(0, maxFailures - recent);
+    }
+
+    public synchronized void recordSuccess(String username) {
+        String key = key(username);
+        failures.remove(key);
+        lockedUntil.remove(key);
+    }
+
+    /** 대소문자·공백 차이로 제한을 피하지 못하게 */
+    private static String key(String username) {
+        return username == null ? "" : username.trim().toLowerCase();
+    }
+}
diff --git a/backend/src/main/java/com/lhk/upbitagent/auth/SecurityConfig.java b/backend/src/main/java/com/lhk/upbitagent/auth/SecurityConfig.java
new file mode 100644
index 0000000..6848d24
--- /dev/null
+++ b/backend/src/main/java/com/lhk/upbitagent/auth/SecurityConfig.java
@@ -0,0 +1,86 @@
+package com.lhk.upbitagent.auth;
+
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.security.authentication.AuthenticationManager;
+import org.springframework.security.config.annotation.authentication.configuration.AuthenticationConfiguration;
+import org.springframework.security.config.annotation.web.builders.HttpSecurity;
+import org.springframework.security.config.annotation.web.configurers.AbstractHttpConfigurer;
+import org.springframework.security.config.http.SessionCreationPolicy;
+import org.springframework.security.core.userdetails.User;
+import org.springframework.security.core.userdetails.UserDetailsService;
+import org.springframework.security.core.userdetails.UsernameNotFoundException;
+import org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder;
+import org.springframework.security.crypto.password.PasswordEncoder;
+import org.springframework.security.web.SecurityFilterChain;
+import org.springframework.security.web.authentication.UsernamePasswordAuthenticationFilter;
+import org.springframework.security.web.util.matcher.RequestMatcher;
+
+import java.nio.charset.StandardCharsets;
+
+/**
+ * 보안 설정. "어떤 주소는 로그인 없이 되고, 나머지는 로그인해야 된다" 를 정하는 곳.
+ *
+ * 요청이 들어오면 컨트롤러에 닿기 전에 필터들을 차례로 지나간다 (보안 필터 체인).
+ *   요청 → JwtAuthFilter(토큰 확인) → 권한 규칙 확인 → 컨트롤러
+ */
+@Configuration
+public class SecurityConfig {
+
+    /** 로그인 없이 허용하는 주소 */
+    private static final RequestMatcher PUBLIC = request -> {
+        String uri = request.getRequestURI();
+        return uri.equals("/api/auth/login")
+                || uri.startsWith("/h2-console")   // 개발용 DB 콘솔 (H2 자체 로그인이 따로 있음)
+                || uri.equals("/error");           // 스프링 기본 에러 응답
+    };
+
+    @Bean
+    public SecurityFilterChain securityFilterChain(HttpSecurity http, JwtProvider jwt, AppUserRepository users)
+            throws Exception {
+        http
+                // JWT 를 헤더로 보내는 방식이라 쿠키 기반 공격(CSRF)이 해당되지 않아 끈다
+                .csrf(AbstractHttpConfigurer::disable)
+                // 스프링 기본 로그인 화면·팝업은 안 쓴다 (Vue 화면에서 직접 로그인)
+                .formLogin(AbstractHttpConfigurer::disable)
+                .httpBasic(AbstractHttpConfigurer::disable)
+                // 세션을 만들지 않는다 = 서버가 로그인 상태를 기억하지 않는다 (JWT 방식의 핵심)
+                .sessionManagement(s -> s.sessionCreationPolicy(SessionCreationPolicy.STATELESS))
+                // H2 콘솔이 iframe 을 써서 같은 사이트 안에서는 허용
+                .headers(h -> h.frameOptions(f -> f.sameOrigin()))
+                .authorizeHttpRequests(a -> a
+                        .requestMatchers(PUBLIC).permitAll()
+                        .anyRequest().authenticated())
+                // 로그인 안 한 요청 → 스프링 기본 화면 대신 JSON 401
+                .exceptionHandling(e -> e.authenticationEntryPoint((request, response, ex) -> {
+                    response.setStatus(401);
+                    response.setContentType("application/json");
+                    response.setCharacterEncoding(StandardCharsets.UTF_8.name());
+                    response.getWriter().write("{\"message\":\"로그인이 필요해요\"}");
+                }))
+                // 아이디·비밀번호 필터보다 먼저 토큰을 확인
+                .addFilterBefore(new JwtAuthFilter(jwt, users), UsernamePasswordAuthenticationFilter.class);
+
+        return http.build();
+    }
+
+    /** 비밀번호 해시. BCrypt 는 같은 비밀번호도 매번 다른 해시가 나오고, 일부러 느리게 만들어 대입 공격을 어렵게 한다 */
+    @Bean
+    public PasswordEncoder passwordEncoder() {
+        return new BCryptPasswordEncoder();
+    }
+
+    /** 로그인할 때 스프링 시큐리티가 "이 아이디의 계정 정보" 를 DB 에서 가져오는 방법 */
+    @Bean
+    public UserDetailsService userDetailsService(AppUserRepository users) {
+        return username -> users.findByUsername(username)
+                .map(u -> User.withUsername(u.username()).password(u.passwordHash()).roles("ADMIN").build())
+                .orElseThrow(() -> new UsernameNotFoundException(username));
+    }
+
+    /** 아이디·비밀번호 확인을 맡는 객체. 위의 UserDetailsService + PasswordEncoder 로 자동 구성된다 */
+    @Bean
+    public AuthenticationManager authenticationManager(AuthenticationConfiguration config) throws Exception {
+        return config.getAuthenticationManager();
+    }
+}
