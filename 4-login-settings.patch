+
+/**
+ * 로그인 계정 테이블(app_user) 접근.
+ */
+@Repository
+public class AppUserRepository {
+
+    /**
+     * @param passwordChangedAt 비밀번호를 마지막으로 바꾼 시각(ms). 처음 만든 뒤 안 바꿨으면 null
+     */
+    public record AppUser(long id, String username, String passwordHash, long createdAt, Long passwordChangedAt) {
+
+        /**
+         * 이 토큰이 아직 유효한지: 비밀번호를 바꾸기 "전"에 발급된 토큰은 거부한다.
+         * JWT 의 발급 시각(iat)은 초 단위로 저장되므로 초 단위로 비교한다.
+         */
+        public boolean acceptsTokenIssuedAt(long issuedAtMs) {
+            return passwordChangedAt == null || issuedAtMs / 1000 >= passwordChangedAt / 1000;
+        }
+    }
+
+    private static final RowMapper<AppUser> MAPPER = (rs, i) -> {
+        long changed = rs.getLong("password_changed_at");
+        return new AppUser(
+                rs.getLong("id"),
+                rs.getString("username"),
+                rs.getString("password_hash"),
+                rs.getLong("created_at"),
+                rs.wasNull() ? null : changed);
+    };
+
+    private final NamedParameterJdbcTemplate jdbc;
+
+    public AppUserRepository(NamedParameterJdbcTemplate jdbc) {
+        this.jdbc = jdbc;
+    }
+
+    public Optional<AppUser> findByUsername(String username) {
+        return jdbc.query("SELECT * FROM app_user WHERE username = :u",
+                new MapSqlParameterSource("u", username), MAPPER).stream().findFirst();
+    }
+
+    public long count() {
+        Long n = jdbc.queryForObject("SELECT COUNT(*) FROM app_user", new MapSqlParameterSource(), Long.class);
+        return n == null ? 0 : n;
+    }
+
+    public void insert(String username, String passwordHash, long now) {
+        jdbc.update("INSERT INTO app_user (username, password_hash, created_at) VALUES (:u, :h, :now)",
+                new MapSqlParameterSource("u", username).addValue("h", passwordHash).addValue("now", now));
+    }
+
+    public void updatePassword(String username, String passwordHash, long now) {
+        jdbc.update("UPDATE app_user SET password_hash = :h, password_changed_at = :now WHERE username = :u",
+                new MapSqlParameterSource("u", username).addValue("h", passwordHash).addValue("now", now));
+    }
+}
diff --git a/backend/src/main/java/com/lhk/upbitagent/auth/AuthBootstrap.java b/backend/src/main/java/com/lhk/upbitagent/auth/AuthBootstrap.java
new file mode 100644
index 0000000..3eee582
--- /dev/null
+++ b/backend/src/main/java/com/lhk/upbitagent/auth/AuthBootstrap.java
@@ -0,0 +1,89 @@
+package com.lhk.upbitagent.auth;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.boot.ApplicationArguments;
+import org.springframework.boot.ApplicationRunner;
+import org.springframework.security.crypto.password.PasswordEncoder;
+import org.springframework.stereotype.Component;
+
+import java.security.SecureRandom;
+
+/**
+ * 서버가 다 켜진 직후 한 번 실행 (ApplicationRunner).
+ * - 계정이 하나도 없으면 관리자 계정을 만든다.
+ * - app.auth.reset-on-start=true 이면 관리자 비밀번호를 다시 만든다 (비밀번호를 잊었을 때).
+ *
+ * 비밀번호를 설정하지 않았으면 무작위로 만들어 콘솔에 "한 번만" 보여준다.
+ * DB 에는 BCrypt 해시만 저장되므로, 이 로그를 놓치면 원래 비밀번호는 다시 볼 수 없다 → 재설정으로 해결.
+ */
+@Component
+public class AuthBootstrap implements ApplicationRunner {
+
+    private static final Logger log = LoggerFactory.getLogger(AuthBootstrap.class);
+    private static final String CHARS = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789"; // 헷갈리는 0/O, 1/l 제외
+
+    private final AppUserRepository users;
+    private final PasswordEncoder passwordEncoder;
+    private final String username;
+    private final String initialPassword;
+    private final boolean resetOnStart;
+
+    public AuthBootstrap(AppUserRepository users, PasswordEncoder passwordEncoder,
+                         @Value("${app.auth.initial-username:admin}") String username,
+                         @Value("${app.auth.initial-password:}") String initialPassword,
+                         @Value("${app.auth.reset-on-start:false}") boolean resetOnStart) {
+        this.users = users;
+        this.passwordEncoder = passwordEncoder;
+        this.username = username;
+        this.initialPassword = initialPassword;
+        this.resetOnStart = resetOnStart;
+    }
+
+    @Override
+    public void run(ApplicationArguments args) {
+        boolean exists = users.findByUsername(username).isPresent();
+        if (users.count() > 0 && !(resetOnStart && exists)) {
+            return; // 이미 계정이 있고 재설정 요청도 없으면 아무것도 안 함
+        }
+
+        boolean generated = initialPassword == null || initialPassword.isBlank();
+        String password = generated ? randomPassword(12) : initialPassword;
+        String hash = passwordEncoder.encode(password);
+        long now = System.currentTimeMillis();
+
+        if (exists) {
+            users.updatePassword(username, hash, now);
+        } else {
+            users.insert(username, hash, now);
+        }
+
+        String action = exists ? "관리자 비밀번호를 다시 만들었어요" : "관리자 계정을 만들었어요";
+        if (generated) {
+            log.warn("""
+
+                    ==================================================
+                      {}
+                      아이디   : {}
+                      비밀번호 : {}
+                      → 로그인 후 설정 탭에서 비밀번호를 바꿔주세요.
+                      (이 비밀번호는 지금 한 번만 보여요)
+                    ==================================================""", action, username, password);
+        } else {
+            log.warn("{}: {} (비밀번호는 ADMIN_PASSWORD 값)", action, username);
+        }
+        if (resetOnStart) {
+            log.warn("ADMIN_RESET 을 다시 false 로 바꿔주세요. 켜두면 재시작할 때마다 비밀번호가 바뀌어요.");
+        }
+    }
+
+    private static String randomPassword(int length) {
+        SecureRandom r = new SecureRandom();
+        StringBuilder sb = new StringBuilder(length);
+        for (int i = 0; i < length; i++) {
+            sb.append(CHARS.charAt(r.nextInt(CHARS.length())));
+        }
+        return sb.toString();
+    }
+}
diff --git a/backend/src/main/java/com/lhk/upbitagent/auth/AuthService.java b/backend/src/main/java/com/lhk/upbitagent/auth/AuthService.java
new file mode 100644
index 0000000..ae77e00
--- /dev/null
+++ b/backend/src/main/java/com/lhk/upbitagent/auth/AuthService.java
@@ -0,0 +1,108 @@
+package com.lhk.upbitagent.auth;
+
+import org.springframework.security.authentication.AuthenticationManager;
+import org.springframework.security.authentication.UsernamePasswordAuthenticationToken;
+import org.springframework.security.core.AuthenticationException;
+import org.springframework.security.crypto.password.PasswordEncoder;
+import org.springframework.stereotype.Service;
+
+import java.nio.charset.StandardCharsets;
+
+/**
+ * 로그인·비밀번호 변경.
+ */
+@Service
+public class AuthService {
+
+    public static final int MIN_PASSWORD_LENGTH = 8;
+
+    private final AuthenticationManager authenticationManager;
+    private final AppUserRepository users;
+    private final PasswordEncoder passwordEncoder;
+    private final JwtProvider jwt;
+    private final LoginAttemptLimiter limiter = LoginAttemptLimiter.defaults();
+
+    public AuthService(AuthenticationManager authenticationManager, AppUserRepository users,
+                       PasswordEncoder passwordEncoder, JwtProvider jwt) {
+        this.authenticationManager = authenticationManager;
+        this.users = users;
+        this.passwordEncoder = passwordEncoder;
+        this.jwt = jwt;
+    }
+
+    /**
+     * 로그인 흐름
+     * 1) 잠겨 있으면 거부 (5번 틀리면 10분)
+     * 2) AuthenticationManager 에 아이디·비밀번호를 넘김
+     *    → UserDetailsService 로 DB 에서 계정을 찾고 → PasswordEncoder(BCrypt)로 비밀번호 비교
+     * 3) 맞으면 JWT 발급, 틀리면 실패 횟수 기록
+     */
+    public JwtProvider.Issued login(String username, String password) {
+        long now = System.currentTimeMillis();
+        String name = username == null ? "" : username.trim();
+
+        Long lockedUntil = limiter.lockedUntil(name, now);
+        if (lockedUntil != null) {
+            long minutes = Math.max(1, (lockedUntil - now + 59_999) / 60_000);
+            throw new AuthError(429, "로그인 시도가 너무 많아요. " + minutes + "분 뒤에 다시 시도해주세요.");
+        }
+
+        try {
+            authenticationManager.authenticate(new UsernamePasswordAuthenticationToken(name, password));
+        } catch (AuthenticationException e) {
+            // 아이디가 없는 경우와 비밀번호가 틀린 경우를 구분해서 알려주지 않는다 (아이디 존재 여부 노출 방지)
+            boolean locked = limiter.recordFailure(name, now);
+            if (locked) {
+                throw new AuthError(429, "5번 틀려서 10분 동안 로그인이 잠겼어요.");
+            }
+            throw new AuthError(401, "아이디 또는 비밀번호가 맞지 않아요. (남은 시도 "
+                    + limiter.remainingAttempts(name, now) + "회)");
+        }
+
+        limiter.recordSuccess(name);
+        return jwt.issue(name);
+    }
+
+    /**
+     * 비밀번호 변경. 바꾸면 이전에 발급된 토큰은 모두 무효가 되므로 새 토큰을 돌려준다.
+     */
+    public JwtProvider.Issued changePassword(String username, String currentPassword, String newPassword) {
+        AppUserRepository.AppUser user = users.findByUsername(username)
+                .orElseThrow(() -> new AuthError(401, "로그인이 필요해요"));
+
+        if (currentPassword == null || !passwordEncoder.matches(currentPassword, user.passwordHash())) {
+            throw new AuthError(400, "현재 비밀번호가 맞지 않아요.");
+        }
+        validateNewPassword(newPassword);
+        if (passwordEncoder.matches(newPassword, user.passwordHash())) {
+            throw new AuthError(400, "지금 비밀번호와 다른 비밀번호를 입력해주세요.");
+        }
+
+        users.updatePassword(username, passwordEncoder.encode(newPassword), System.currentTimeMillis());
+        return jwt.issue(username);
+    }
+
+    static void validateNewPassword(String pw) {
+        if (pw == null || pw.length() < MIN_PASSWORD_LENGTH) {
+            throw new AuthError(400, "새 비밀번호는 " + MIN_PASSWORD_LENGTH + "자 이상이어야 해요.");
+        }
+        // BCrypt 는 72바이트까지만 비교해서, 그보다 길면 뒷부분이 무시된다
+        if (pw.getBytes(StandardCharsets.UTF_8).length > 72) {
+            throw new AuthError(400, "새 비밀번호가 너무 길어요. (최대 72바이트)");
+        }
+    }
+
+    /** 화면에 그대로 보여줄 메시지와 HTTP 상태 */
+    public static class AuthError extends RuntimeException {
+        private final int status;
+
+        public AuthError(int status, String message) {
+            super(message);
+            this.status = status;
+        }
+
+        public int status() {
+            return status;
+        }
+    }
+}
