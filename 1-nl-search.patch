+    "bbLowerTouchWithin": { "type": "integer", "description": "최근 N봉 이내 볼린저밴드 하단을 터치했고 지금은 하단 위(반등). 1~50" },
+    "volumeSurgeRatio": { "type": "number", "description": "직전 완성봉 거래량이 이전 20봉 평균의 X배 이상. 예: '거래량 터진' → 3" },
+    "atrPctMin": { "type": "number", "description": "ATR(14)/현재가 변동성 최소(%)" },
+    "atrPctMax": { "type": "number", "description": "ATR(14)/현재가 변동성 최대(%). 예: '변동성 낮은' → 2" },
+    "dropFromHighMin": { "type": "number", "description": "최근 20봉 최고가 대비 하락률 최소(%). 예: '고점에서 10% 이상 빠진' → 10" },
+    "dropFromHighMax": { "type": "number", "description": "최근 20봉 최고가 대비 하락률 최대(%). 예: '고점 근처' → 2" },
+    "sortBy": {
+      "type": "string",
+      "enum": ["VOLUME_SURGE", "TRADE_AMOUNT", "CHANGE_RATE", "RSI_ASC"],
+      "description": "결과 정렬. 거래량 급증 배수 / 거래대금 / 등락률 / RSI 낮은 순"
