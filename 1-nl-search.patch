+  display: block;
+  font-weight: 600;
+  margin-bottom: 8px;
+}
+
+.nl-row {
+  display: flex;
+  gap: 10px;
+  align-items: stretch;
+}
+
+textarea {
+  flex: 1;
+  resize: vertical;
+  background: #0d1117;
+  color: white;
+  border: 1px solid #30363d;
+  border-radius: 8px;
+  padding: 10px 12px;
+  font-size: 0.95rem;
+}
